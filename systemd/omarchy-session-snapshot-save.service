[Unit]
Description=Save the Omarchy desktop session snapshot on session end
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c true
ExecStop=%h/.config/omarchy/plugins/hancore.session-snapshot/scripts/save-on-exit
TimeoutStopSec=20

[Install]
WantedBy=graphical-session.target
