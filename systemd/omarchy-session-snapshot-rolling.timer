[Unit]
Description=Periodically refresh the Omarchy desktop session snapshot
PartOf=graphical-session.target
After=omarchy-session-snapshot-restore.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=1min
Unit=omarchy-session-snapshot-rolling.service

[Install]
WantedBy=graphical-session.target
